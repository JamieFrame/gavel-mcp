# MCP server listener
PORT=3002
NODE_ENV=production
LOG_LEVEL=info

# Upstream REST API — Aletheia data product
GAVEL_API_BASE_URL=http://localhost:3001

# Arbitrum RPC endpoints — used by Phase 1.5 read tools (check_wallet_status etc.)
# Defaults are public RPCs (rate-limited). For production, point at a paid
# Alchemy / Infura / QuickNode endpoint to avoid throttling.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Anonymous (no-auth) tier rate limit
RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
RATE_LIMIT_ANONYMOUS_PER_DAY=10000

# Paid tier rate limit (single bucket for v1; per-key tiers come later)
RATE_LIMIT_PAID_PER_MINUTE=300

# Optional CORS origins (comma-separated). Leave blank to disable CORS.
CORS_ALLOWED_ORIGINS=

# Health-check secret (optional — if set, /health requires ?secret=<value>)
HEALTH_CHECK_SECRET=

# Testnet API host. Optional: without it, testnet requests error rather than
# silently returning mainnet data under a testnet label.
GAVEL_API_TESTNET_BASE_URL=https://api-testnet.thegavel.io
