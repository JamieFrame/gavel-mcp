# The Bitcoin Credit Stack MCP — observatory profile (OB1).
# Interim host: data-mcp.thegavel.io (DNS record not yet created).
MCP_PROFILE=observatory
PORT=3004
NODE_ENV=production
LOG_LEVEL=info

# Same backend as the Gavel server — both-split reads MUST come from here so
# split_payload_parity can hold. Do not point this at a second API.
GAVEL_API_BASE_URL=http://localhost:3001
GAVEL_API_TESTNET_BASE_URL=https://api-testnet.thegavel.io

# Tier resolution. Absent, every caller resolves to `free` with a warn per
# request; the observatory is a free surface today, so this is deliberate.
RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
RATE_LIMIT_PAID_PER_MINUTE=300
CORS_ALLOWED_ORIGINS=
