# dependencies
node_modules/
# ...and as a bare name. `node_modules/` matches a DIRECTORY only, so when a git
# worktree carries node_modules as a SYMLINK to this checkout's copy, `git add`
# happily tracked it. Merging that branch then wrote the symlink here pointing
# at ITSELF, and the next `systemctl restart` died with "Cannot find package
# 'express'" — twice, on 2026-08-29. Give a worktree its own npm install.
node_modules

# build output
dist/

# environment
.env
.env.local
.env.*.local
# OB1: per-profile host env. Real values live on the host; the example is committed.
.env.observatory

# logs
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# local backups / release tarballs
*.tar.gz
*.bak

# local pre-change backups (\.env.bak-pre-r18 holds INTERNAL_API_SECRET)
.env.bak*
dist.bak*

# Deployment units — host paths, not application code. Kept out of the public
# repository; they live on the host and in the ops runbook.
deployment/
# Stray editor/backup files must never reach a published repo.
*.pre-*
*.bak-*
