[Unit]
Description=Aletheia MCP Server
Documentation=https://github.com/aletheia/gavel-mcp-server
After=network-online.target gavel-api.service
Wants=network-online.target
Requires=gavel-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/gavel-mcp
EnvironmentFile=/root/gavel-mcp/.env
ExecStart=/usr/bin/node /root/gavel-mcp/dist/http.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# Logging — matches the pattern used by gavel-api / gavel-credit-complex
StandardOutput=append:/var/log/gavel-mcp.log
StandardError=append:/var/log/gavel-mcp.log
SyslogIdentifier=gavel-mcp

# Light hardening — same as other Gavel services
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
