{
  "name": "gavel-mcp-server",
  "version": "0.3.0",
  "description": "Aletheia MCP server — agent-native interface over the Gavel data product.",
  "type": "module",
  "main": "dist/http.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/http.js",
    "dev": "tsx watch src/http.ts",
    "typecheck": "tsc -p . --noEmit",
    "clean": "rm -rf dist",
    "check:advertised": "node scripts/check-advertised.mjs",
    "check:surface": "node scripts/check-surface.mjs https://mcp.bitcoincreditstack.com/mcp",
    "check:profiles": "node scripts/check-profiles.mjs",
    "check:alignment": "node scripts/check-lens-alignment.mjs",
    "check": "npm run build && npm run check:profiles && npm run check:alignment",
    "check:transport": "node scripts/check-transport.mjs"
  },
  "dependencies": {
    "@coinbase/x402": "2.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/mcp": "2.28.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "ethers": "^6.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@coinbase/cdp-sdk": "1.57.1"
  }
}
