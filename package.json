{
  "name": "gavel-mcp-server",
  "version": "0.3.0",
  "description": "Aletheia MCP server — agent-native interface over the Gavel data product.",
  "type": "module",
  "main": "dist/http.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/http.js",
    "dev": "tsx watch src/http.ts",
    "typecheck": "tsc -p . --noEmit",
    "clean": "rm -rf dist",
    "check:advertised": "node scripts/check-advertised.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "ethers": "^6.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
